{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xuanji-sample",
  "title": "玄机 · 云端样本（时间 + 事件）",
  "description": "本项目所有云端样本统一为「时间 + 事件」两段式：出生时间给出盘，事件给出可检验的锚点。不含姓名、联系方式、IP 等任何可识别个人的信息。",
  "type": "object",
  "required": [
    "id",
    "birth",
    "events",
    "consent"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "匿名样本 ID（随机生成，不含任何个人信息）"
    },
    "birth": {
      "type": "object",
      "required": [
        "at",
        "lng",
        "lat"
      ],
      "properties": {
        "at": {
          "type": "string",
          "description": "出生时刻 YYYY-MM-DD HH:mm（本地民用时）"
        },
        "tz": {
          "type": "number",
          "description": "时区偏移（小时），缺省 8"
        },
        "lng": {
          "type": "number"
        },
        "lat": {
          "type": "number"
        },
        "gender": {
          "type": "string",
          "enum": [
            "男",
            "女",
            "未填"
          ]
        },
        "timePrecision": {
          "type": "string",
          "enum": [
            "exact",
            "hour",
            "period",
            "day-only",
            "unknown"
          ],
          "description": "exact=精确到分｜hour=只到时辰｜period=只知道上/下午｜day-only=只知道日期｜unknown=不知"
        },
        "rectified": {
          "type": "boolean",
          "description": "是否经过生时矫正"
        },
        "rectifiedWindow": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string"
            },
            "to": {
              "type": "string"
            }
          },
          "description": "矫正后的时间窗口（含端点）"
        }
      }
    },
    "events": {
      "type": "array",
      "description": "生平事件 —— 这是样本最有价值的部分：它给出可检验的锚点",
      "items": {
        "type": "object",
        "required": [
          "year",
          "kind"
        ],
        "properties": {
          "year": {
            "type": "number",
            "description": "年份（必须）；精度到年即可"
          },
          "month": {
            "type": "number",
            "minimum": 1,
            "maximum": 12
          },
          "day": {
            "type": "number",
            "minimum": 1,
            "maximum": 31
          },
          "kind": {
            "type": "string",
            "enum": [
              "求学",
              "就业",
              "升迁",
              "创业",
              "婚姻",
              "生育",
              "离婚",
              "疾病",
              "亲丧",
              "迁移",
              "破财",
              "得财",
              "官非",
              "意外",
              "修行",
              "其他"
            ]
          },
          "note": {
            "type": "string",
            "description": "一句话描述（可选，勿写可识别信息）"
          },
          "certainty": {
            "type": "string",
            "enum": [
              "确定",
              "大致",
              "存疑"
            ]
          }
        }
      }
    },
    "consent": {
      "type": "object",
      "required": [
        "contribute",
        "ts"
      ],
      "properties": {
        "contribute": {
          "type": "boolean",
          "description": "必须显式为 true 才允许云端留存"
        },
        "ts": {
          "type": "string",
          "description": "同意时间（ISO8601）"
        },
        "scope": {
          "type": "string",
          "description": "同意范围，如 \"仅用于模型校准\""
        }
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "自行填写",
            "生时矫正流程",
            "合盘流程",
            "其他"
          ]
        },
        "version": {
          "type": "string"
        }
      }
    }
  }
}